{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Catalog: run API",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["catalog.main:app", "--reload", "--host", "127.0.0.1", "--port", "8000"],
      "justMyCode": true
    },
    {
      "name": "Catalog: pytest API + DB",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["tests/test_api.py", "tests/test_database.py", "-q"],
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
